services:
  easytier-config-server:
    image: docker.io/easytier/easytier:v2.6.4
    container_name: easytier-config-server
    restart: unless-stopped
    user: "65532:65532"
    read_only: true
    mem_limit: 256m
    cpus: 1.0
    pids_limit: 128
    cap_drop:
      - ALL
    security_opt:
      - no-new-privileges:true
    entrypoint:
      - /sbin/tini
      - --
      - easytier-web-embed
    command:
      - --api-server-port
      - "11211"
      - --api-server-addr
      - 0.0.0.0
      - --api-host
      - https://<ET_CONFIG_SERVER_DOMAIN>
      - --config-server-port
      - "22020"
      - --config-server-protocol
      - ws
      - --db
      - /data/et.db
      - --console-log-level
      - info
      - --file-log-level
      - info
      - --file-log-dir
      - /logs
      - --disable-registration
    ports:
      - 127.0.0.1:11211:11211/tcp
      - 127.0.0.1:22020:22020/tcp
    volumes:
      - /opt/easytier-config-server/data:/data
      - /opt/easytier-config-server/logs:/logs
    tmpfs:
      - /tmp:size=16m,mode=1777
    healthcheck:
      test:
        - CMD-SHELL
        - wget -q -O /dev/null http://127.0.0.1:11211/ || exit 1
      interval: 30s
      timeout: 5s
      retries: 3
      start_period: 15s
    logging:
      driver: json-file
      options:
        max-size: 10m
        max-file: "3"
