[Unit]
Description=EasyTier managed node
Wants=network-online.target
After=network-online.target docker.service

[Service]
Type=simple
WorkingDirectory=/opt/easytier
EnvironmentFile=/opt/easytier/etc/node.env
ExecStart=/opt/easytier/bin/easytier-core
Restart=always
RestartSec=3s
LimitNOFILE=1048576
UMask=0077

[Install]
WantedBy=multi-user.target
