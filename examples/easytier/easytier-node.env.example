# Store the real file at /opt/easytier/etc/node.env with mode 0600.
# ET_MACHINE_ID must be fixed and unique. Do not copy one server's value to
# another server.

ET_CONFIG_SERVER=wss://<ET_CONFIG_SERVER_DOMAIN>/<ET_CONFIG_SERVER_USERNAME>
ET_CONFIG_DIR=/opt/easytier/config
ET_MACHINE_ID=<FIXED_UNIQUE_MACHINE_ID>
ET_HOSTNAME=<UNIQUE_NODE_HOSTNAME>
ET_RPC_PORTAL=127.0.0.1:15888
ET_CONSOLE_LOG_LEVEL=info
ET_FILE_LOG_LEVEL=info
ET_FILE_LOG_DIR=/opt/easytier/logs
