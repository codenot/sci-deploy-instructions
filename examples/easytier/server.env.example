# Copy to /opt/easytier/config/server.env and chmod 600. Never commit the real
# file. ET_NETWORK_NAME and ET_NETWORK_SECRET must match on every node;
# ET_INSTANCE_NAME and ET_IPV4 must be unique on every node.

ET_NETWORK_NAME=easytier
ET_NETWORK_SECRET=<GENERATE_A_STRONG_SHARED_SECRET>
ET_INSTANCE_NAME=<UNIQUE_SERVER_NAME>
ET_IPV4=<UNIQUE_EASYTIER_IPV4>
ET_SEED_HOST=<PUBLIC_SEED_IP_OR_DOMAIN>
